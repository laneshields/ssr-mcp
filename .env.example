# Hostname or IP of your Conductor or standalone SSR router
SSR_HOST=192.168.1.1

SSR_USERNAME=admin
SSR_PASSWORD=your-password-here

# Set to "false" for self-signed certificates (common in lab/production SSR deployments)
SSR_VERIFY_SSL=true

# HTTPS port — override if the conductor listens on a non-standard port (default 443)
# SSR_PORT=8443

# Transport for the MCP server. Options: stdio (default), sse, streamable-http
# SSR_MCP_TRANSPORT=streamable-http

# Bind address and port for HTTP transports (ignored for stdio)
# SSR_MCP_HOST=0.0.0.0
# SSR_MCP_PORT=8000

# Bearer token required on all HTTP requests (ignored for stdio).
# Leave unset to disable auth (not recommended for internet-exposed deployments).
# SSR_MCP_AUTH_TOKEN=your-secret-token-here
